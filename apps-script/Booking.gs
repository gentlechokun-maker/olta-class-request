const BOOKING_TABLES_={
 '상담예약':['id','createdAt','parent','phone','student','grade','school','consultationType','date','start','end','status','token','note','consentVersion','consentAt'],
 '설명회':['id','title','date','start','location','onlineInfo','enabled'],
 '설명회신청':['id','createdAt','parent','phone','student','grade','school','eventId','mode','date','start','status','token','note','consentVersion','consentAt'],
 '방문상담':['id','createdAt','parent','phone','student','grade','school','targetId','category','date','start','end','status','token','note','consentVersion','consentAt'],
 '수업주차':['date','grade','weekId'],
 '결석보강':['id','createdAt','parent','phone','student','grade','school','targetId','absenceDate','missedTopic','choice','date','start','end','makeupClassId','position','absenceWeek','weekId','status','teacher','room','token','note','consentVersion','consentAt']
};
function setupBookings(){admin_();return locked_(()=>{ensureBookings_();const rows=bookingRead_('수업주차'),keys=new Set(rows.map(r=>r.date+'|'+r.grade));const added=CALENDAR_2026_.filter(r=>!keys.has(r.date+'|'+r.grade));write_('수업주차',rows.concat(added));audit_('예약 기능 설정',String(added.length));return '예약 운영 표와 2026 수업주차 '+added.length+'일이 추가되었습니다. 기존 입력은 유지했습니다.';});}
function cleanupBookings_(cutoff){if(typeof cleanupReviews_==='function')cleanupReviews_(cutoff);Object.assign(TABLES_,BOOKING_TABLES_);for(const name of ['설명회신청','방문상담','결석보강','상담예약'])if(db_().getSheetByName(name))write_(name,bookingRead_(name).filter(r=>Math.max(Date.parse(r.createdAt)||0,Date.parse((r.date||r.absenceDate)+'T23:59:59+09:00')||0)>=cutoff));}
function ensureBookings_(){Object.assign(TABLES_,BOOKING_TABLES_);const db=db_();for(const [name,headers] of Object.entries(BOOKING_TABLES_)){let s=db.getSheetByName(name);if(!s)s=db.insertSheet(name);if(!s.getLastRow()){s.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e5eddc');s.setFrozenRows(1);}}}
function bookingRead_(name){Object.assign(TABLES_,BOOKING_TABLES_);return db_().getSheetByName(name)?read_(name):[];}
function bookingCatalog_(excludeMakeupId){const catalog=publicCatalog_(),seminars=bookingRead_('설명회'),registrations=bookingRead_('설명회신청');return {...catalog,...consultationCatalog_(catalog),bookingEnabled:true,weeks:bookingRead_('수업주차').map(w=>({date:w.date,grade:w.grade,weekId:w.weekId})),seminars:seminars.filter(e=>enabled_(e.enabled)).map(e=>({id:e.id,title:e.title,date:e.date,start:e.start,location:e.location,onlineInfo:e.onlineInfo,enabled:'true',remaining:Math.max(0,20-registrations.filter(r=>r.eventId===e.id&&r.mode==='onsite'&&r.status!=='취소').length)})),visits:bookingRead_('방문상담').filter(r=>r.status!=='취소').map(r=>({date:r.date,start:r.start,end:r.end,category:r.category,status:'예약'})),makeupSeats:bookingRead_('결석보강').filter(r=>r.id!==excludeMakeupId&&r.choice==='same'&&r.status!=='취소').reduce((a,r)=>{const key=r.makeupClassId+'|'+r.date;a[key]=(a[key]||0)+1;return a;},{})};}
function bookingTable_(kind){const name={seminar:'설명회신청',visit:'방문상담',absence:'결석보강',consultation:'상담예약'}[kind];if(!name)throw Error('신청 종류를 확인해 주세요.');return name;}
function linkVisitRequest_(r){if(read_('신청').some(x=>x.id===r.id))return;append_('신청',{id:r.id,createdAt:r.createdAt,kind:'existing',targetId:r.targetId,student:r.student,grade:r.grade,phone:r.phone,note:'방문 상담 '+r.date+' '+r.start+'–'+r.end+' / '+r.note,status:'접수',consentVersion:BOOKING_VERSION,consentAt:r.consentAt});}
function submitBooking_(input){ensureBookings_();if(input.kind==='booking_cancel')return cancelBooking_(input);const kind=input.kind,table=bookingTable_(kind),rows=bookingRead_(table),identity=bookingIdentity(input,!['absence','consultation'].includes(kind));const same=rows.find(r=>r.id===identity.requestId);if(same){if(same.token!==identity.token||same.phone!==identity.phone||same.parent!==identity.parent||same.student!==identity.student||same.school!==identity.school||same.grade!==identity.grade||['consultationType','eventId','mode','targetId','absenceDate','choice','date','start','makeupClassId','position'].some(k=>input[k]&&String(same[k]||'')!==String(input[k])))throw Error('접수번호가 일치하지 않습니다.');if(same.status==='취소')throw Error('취소된 접수입니다. 신청 화면을 다시 열어 주세요.');if(kind==='visit')linkVisitRequest_(same);return bookingResult_(same,kind,true);}let r;
 if(kind==='consultation')r=validateConsultation(input,consultationCatalog_(publicCatalog_()));
 if(kind==='seminar')r=validateSeminar(input,bookingRead_('설명회').find(e=>e.id===input.eventId),rows);
 if(kind==='visit')r=validateVisit(input,publicCatalog_().classes.find(c=>c.id===input.targetId),rows);
 if(kind==='absence'){r=validateAbsence(input,bookingCatalog_());if(r.choice==='same')checkMakeupSeat_(r);}
 const duplicate=rows.find(x=>x.status!=='취소'&&x.phone===r.phone&&x.student===r.student&&(kind==='seminar'?x.eventId===r.eventId:['visit','consultation'].includes(kind)?x.date===r.date&&x.start===r.start:x.targetId===r.targetId&&x.absenceDate===r.absenceDate));if(duplicate)throw Error('이미 접수된 신청이 있습니다. 기존 접수번호로 취소하거나 학원에 문의해 주세요.');
 r={...r,id:r.requestId,createdAt:now_(),consentVersion:BOOKING_VERSION,consentAt:now_(),status:kind==='absence'?(r.choice==='pass'?'패스':'접수'):'예약'};append_(table,r);if(kind==='visit')linkVisitRequest_(r);SpreadsheetApp.flush();return bookingResult_(r,kind,false);
}
function bookingResult_(r,kind,duplicate){return {ok:true,id:r.id,kind,eventId:r.eventId||'',token:r.token,duplicate,message:kind==='consultation'?consultationLabel(r.consultationType)+' '+r.date+' '+r.start+'–'+r.end+' 예약이 완료되었습니다.':kind==='seminar'?'설명회 '+(r.mode==='onsite'?'대면':'온라인')+' 신청이 완료되었습니다.':kind==='visit'?'방문 상담 '+r.date+' '+r.start+'–'+r.end+' 예약이 완료되었습니다. 수강 등록은 상담 후 별도로 확정됩니다.':r.choice==='pass'?weekLabel(r.absenceWeek)+' 결석 및 보강 패스가 기록되었습니다.':weekLabel(r.absenceWeek)+' 수업 보강 요청이 접수되었습니다. 보강 일정: '+r.date+' '+r.start+'–'+r.end+' ('+weekLabel(r.weekId)+'). 관리자 확인 후 확정됩니다.'};}
function cancelBooking_(input){const table=bookingTable_(input.bookingKind),rows=bookingRead_(table),r=rows.find(x=>x.id===input.id);if(!r||r.token!==String(input.token||''))throw Error('접수번호와 확인 코드를 확인해 주세요.');if(input.bookingKind==='seminar'&&r.mode==='onsite'){const e=bookingRead_('설명회').find(e=>e.id===r.eventId);if(!e||Date.now()>seminarDeadline(e.date,14))throw Error('대면 설명회 취소는 전날 14시까지 가능합니다. 학원으로 문의해 주세요.');}r.status='취소';write_(table,rows);if(input.bookingKind==='visit'){const requests=read_('신청'),linked=requests.find(x=>x.id===r.id);if(linked&&['접수','상담 중'].includes(linked.status)){linked.status='취소';write_('신청',requests);}}return {ok:true,id:r.id,message:'신청이 취소되었습니다.'};}
function checkMakeupSeat_(r){const c=publicCatalog_().classes.find(c=>c.id===r.makeupClassId);if(!c||c.review)throw Error('보강할 반의 시간표 확인이 필요합니다.');const reserved=bookingRead_('결석보강').filter(x=>x.id!==r.id&&x.makeupClassId===c.id&&x.date===r.date&&x.choice==='same'&&x.status!=='취소').length;const assignments=read_('보강').filter(x=>x.classId===c.id&&x.status==='배정');const names=new Set(read_('원생').filter(x=>x.classId===c.id&&x.status==='makeup'&&!assignments.some(m=>m.student===x.name&&m.date>=today_())).map(x=>x.name));assignments.filter(x=>x.date===r.date).forEach(x=>names.add(x.student));const legacy=names.size;if(c.remaining-reserved-legacy<1)throw Error('해당 날짜의 보강 자리가 마감되었습니다. 다른 반을 선택해 주세요.');}
function getBookingAdmin(){admin_();return locked_(()=>{ensureBookings_();return {consultations:bookingRead_('상담예약'),seminars:bookingRead_('설명회'),registrations:bookingRead_('설명회신청'),visits:bookingRead_('방문상담'),absences:bookingRead_('결석보강'),weeks:bookingRead_('수업주차'),classes:classes_(),reviews:reviewRead_(),siteUrl:props_().getProperty('SITE_URL')||''};});}
function openBookingAdmin(){admin_();SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutputFromFile('BookingAdmin').setWidth(1200).setHeight(850),'설명회 · 방문 상담 · 결석과 보강');}
function bookingAdminPage_(action){try{admin_();return HtmlService.createHtmlOutputFromFile(action==='legacyAdmin'?'Admin':'BookingAdmin').setTitle('올타과학 · 비공개 예약 관리').addMetaTag('viewport','width=device-width,initial-scale=1');}catch(error){return HtmlService.createHtmlOutput('<h1>관리자 전용 화면</h1><p>등록된 관리자 Google 계정으로 로그인한 브라우저에서 열어 주세요.</p>').setTitle('관리자 로그인 필요');}}
function saveSeminar(input){admin_();return locked_(()=>{ensureBookings_();const rows=bookingRead_('설명회'),id=String(input.id||Utilities.getUuid()),old=rows.find(e=>e.id===id);bookingInstant(input.date,input.start);if(!String(input.title||'').trim()||String(input.title).length>100)throw Error('설명회 제목을 확인하세요.');if(old&&bookingRead_('설명회신청').some(r=>r.eventId===id&&r.status!=='취소')&&(old.date!==input.date||old.start!==input.start))throw Error('신청자가 있는 설명회는 일정을 바꾸지 마세요. 기존 회차를 비활성화하고 새 회차를 만드세요.');const e={id,title:String(input.title).trim(),date:input.date,start:input.start,location:String(input.location||'').slice(0,200),onlineInfo:String(input.onlineInfo||'').slice(0,300),enabled:input.enabled?'TRUE':'FALSE'};if(old)Object.assign(old,e);else rows.push(e);write_('설명회',rows);audit_('설명회 설정',id);return true;});}
function saveBookingWeeks(input){admin_();return locked_(()=>{ensureBookings_();const incoming=String(input).trim().split(/\r?\n/).filter(Boolean).map(line=>{const [date,grade,weekId]=line.split('\t');bookingDate(date);if(grade!=='전체')bookingCategory(grade);if(!weekId||weekId.length>60)throw Error('주차 ID를 확인하세요.');return {date,grade,weekId};});const keys=new Set();for(const r of incoming){const k=r.date+'|'+r.grade;if(keys.has(k))throw Error('입력에 중복 날짜·학년이 있습니다.');keys.add(k);}const rows=bookingRead_('수업주차').filter(r=>!keys.has(r.date+'|'+r.grade));write_('수업주차',rows.concat(incoming));audit_('수업주차 등록',String(incoming.length));return true;});}
function updateBookingStatus(kind,id,status,teacher,room,verified){admin_();return locked_(()=>{ensureBookings_();const table=bookingTable_(kind),rows=bookingRead_(table),r=rows.find(x=>x.id===id);if(!r)throw Error('신청이 없습니다.');const allowed=kind==='seminar'?['참석','취소']:['visit','consultation'].includes(kind)?['상담 완료','취소']:['확정','완료','취소'];if(!allowed.includes(status))throw Error('처리 상태를 확인하세요.');if(r.status==='취소')throw Error('취소한 신청은 복원할 수 없습니다. 다시 신청하세요.');if(kind==='absence'&&status==='확정'){
 if(r.choice==='pass'||verified!==true)throw Error('재원생 본인과 결석 내용 확인이 필요합니다.');syncTimetable_();const checked=validateAbsence({...r,requestId:r.id,consent:'yes',privacyVersion:BOOKING_VERSION},bookingCatalog_(r.id));if(checked.start!==r.start||checked.end!==r.end)throw Error('수업 시간이 변경되었습니다. 다시 신청하세요.');if(read_('원생').filter(p=>p.classId===r.targetId&&p.name===r.student&&['registered','starting'].includes(p.status)).length!==1)throw Error('재원생 명단과 일치하지 않습니다.');
 if(r.choice==='same'){checkMakeupSeat_(r);const cls=classes_().find(c=>c.id===r.makeupClassId);r.teacher=cls.teacher;r.room=cls.room;}else{teacher=String(teacher||'').trim();room=String(room||'').trim();if(!teacher||!room||teacher.length>40||room.length>40)throw Error('실제 담당 선생님과 교실을 입력하세요.');const day=bookingDay(r.date),collision=x=>r.start<x.end&&x.start<r.end;const classes=classes_();if(!classes.some(c=>c.teacher.includes(teacher))||!classes.some(c=>c.room.includes(room)))throw Error('반설정에 등록된 선생님·교실을 사용하세요.');if(classes.some(c=>c.day===day&&collision(c)&&(c.teacher.includes(teacher)||c.room.includes(room))))throw Error('정규 수업과 선생님 또는 교실 시간이 겹칩니다.');if(rows.concat(makeupRequests_()).some(x=>x.id!==r.id&&x.date===r.date&&['확정','완료'].includes(x.status)&&collision(x)&&(x.teacher===teacher||x.room===room)))throw Error('다른 보강 일정과 겹칩니다.');r.teacher=teacher;r.room=room;}}
 if(kind==='absence'&&status==='완료'&&r.status!=='확정')throw Error('확정된 보강만 완료 처리할 수 있습니다.');r.status=status;write_(table,rows);audit_('예약 '+status,id);return true;});}
function bookingReceipt_(result){const site=props_().getProperty('SITE_URL')||'',safe=/^https:\/\/[a-zA-Z0-9.-]+(?:\/[^\s<>"']*)?$/.test(site)?site:'';const cancel=safe&&result.token?safe.replace(/\/$/,'')+'/booking.html#'+encodeURIComponent(JSON.stringify({id:result.id,token:result.token,kind:result.kind})):'';const review=result.ok&&result.kind==='seminar'?reviewLink_({id:result.id,token:result.token,eventId:result.eventId}):'';return HtmlService.createHtmlOutput('<!doctype html><html lang="ko"><head><meta name="referrer" content="no-referrer"></head><body style="font:17px/1.8 system-ui;color:#17364e;background:#f4f8fc;padding:30px;max-width:650px;margin:auto"><h1>'+ (result.ok?'접수 결과':'접수되지 않았습니다')+'</h1><p>'+escape_(result.message||'신청이 처리되었습니다.')+'</p>'+(result.ok?'<p>접수번호: '+escape_(result.id)+'</p>':'')+(result.token?'<p>확인 코드: '+escape_(result.token)+'</p><p>취소 시 필요합니다. 이 화면을 저장하고 다른 사람에게 공유하지 마세요.</p>':'')+(review?'<p style="background:#e8f2fb;padding:20px;border-radius:12px">설명회가 끝난 뒤 마음을 나눠주세요.<br><a style="color:#00538a;font-weight:bold" target="_top" href="'+escape_(review)+'">올타에듀 학부모 설명회 후기 작성 ↗</a><br><small>신청 정보와 연결된 전용 링크입니다. 다른 사람에게 공유하지 마세요.</small></p>':'')+(cancel?'<p><a target="_top" href="'+escape_(cancel)+'">신청 취소 페이지</a></p>':'')+'</body></html>').setTitle('올타과학 · 접수 결과').addMetaTag('viewport','width=device-width, initial-scale=1');}


function consultationCatalog_(catalog){
 const consultationBusy=bookingRead_('상담예약').concat(bookingRead_('방문상담')).filter(r=>r.status!=='취소').map(r=>({date:r.date,start:r.start,end:r.end}));
 const shinBusy=(catalog.classes||[]).filter(c=>String(c.teacher||'').includes('신T')||!c.teacher).map(c=>({day:c.day,start:c.start,end:c.end}));
 bookingRead_('결석보강').concat(bookingRead_('보강신청')).filter(r=>['확정','완료'].includes(r.status)&&String(r.teacher||'').includes('신T')).forEach(r=>shinBusy.push({date:r.date,start:r.start,end:r.end}));
 return {consultationEnabled:true,consultationBusy,shinBusy};
}
