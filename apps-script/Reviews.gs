const REVIEW_TABLE_='설명회후기';
const REVIEW_HEADERS_=['id','createdAt','eventId','eventDate','registrationId','parent','phone','student','grade','school','answer1','answer2','answer3','answer4','satisfaction','consentVersion','consentAt'];
function reviewRead_(){TABLES_[REVIEW_TABLE_]=REVIEW_HEADERS_;return db_().getSheetByName(REVIEW_TABLE_)?read_(REVIEW_TABLE_):[];}
function ensureReviews_(){TABLES_[REVIEW_TABLE_]=REVIEW_HEADERS_;const db=db_();let sheet=db.getSheetByName(REVIEW_TABLE_);if(!sheet)sheet=db.insertSheet(REVIEW_TABLE_);if(!sheet.getLastRow()){sheet.getRange(1,1,1,REVIEW_HEADERS_.length).setValues([REVIEW_HEADERS_]).setFontWeight('bold').setBackground('#e8f2fb');sheet.setFrozenRows(1);}}
function publicReviewCatalog_(){const p=props_();return {reviewEnabled:true,privacyContact:p.getProperty('PRIVACY_CONTACT')||'010-5725-6442',retentionDays:Number(p.getProperty('RETENTION_DAYS')||90),events:bookingRead_('설명회').map(e=>({id:e.id,title:e.title,date:e.date,start:e.start,open:Date.now()>=bookingInstant(e.date,e.start)})).sort((a,b)=>(b.date+b.start).localeCompare(a.date+a.start))};}
function submitReview_(input){
  const r=validateReview(input),event=bookingRead_('설명회').find(e=>e.id===r.eventId);
  if(!event||Date.now()<bookingInstant(event.date,event.start))throw Error('설명회가 시작된 뒤 후기를 작성하실 수 있습니다.');
  const matches=bookingRead_('설명회신청').filter(x=>x.eventId===event.id&&x.status!=='취소'&&(r.registrationId?x.id===r.registrationId&&x.token===r.registrationToken:x.parent===r.parent&&String(x.phone).replace(/\D/g,'')===r.phone));
  if(matches.length!==1)throw Error('설명회 신청 정보와 일치하지 않습니다. 후기 전용 링크를 이용하거나 학원에 문의해 주세요.');
  const registration=matches[0],rows=reviewRead_(),same=rows.find(x=>x.id===r.requestId);
  if(same){if(same.registrationId!==registration.id||['answer1','answer2','answer3','answer4'].some(k=>String(same[k]||'')!==r[k])||Number(same.satisfaction)!==r.satisfaction)throw Error('후기 접수번호가 일치하지 않습니다. 화면을 새로고침해 주세요.');return {ok:true,id:same.id,duplicate:true};}
  if(rows.some(x=>x.registrationId===registration.id))throw Error('이 설명회의 후기를 이미 보내주셨습니다. 수정이 필요하면 학원에 문의해 주세요.');
  ensureReviews_();const timestamp=now_();append_(REVIEW_TABLE_,{id:r.requestId,createdAt:timestamp,eventId:event.id,eventDate:event.date,registrationId:registration.id,parent:registration.parent,phone:registration.phone,student:registration.student,grade:registration.grade,school:registration.school,answer1:r.answer1,answer2:r.answer2,answer3:r.answer3,answer4:r.answer4,satisfaction:r.satisfaction,consentVersion:REVIEW_VERSION,consentAt:timestamp});SpreadsheetApp.flush();return {ok:true,id:r.requestId};
}
function cleanupReviews_(cutoff){if(db_().getSheetByName(REVIEW_TABLE_))write_(REVIEW_TABLE_,reviewRead_().filter(r=>Math.max(Date.parse(r.createdAt)||0,Date.parse(r.eventDate+'T23:59:59+09:00')||0)>=cutoff));}
function reviewLink_(registration){const site=props_().getProperty('SITE_URL')||'';if(!/^https:\/\/[a-zA-Z0-9.-]+(?:\/[^\s<>"']*)?$/.test(site))return '';return site.replace(/\/$/,'')+'/review.html#'+encodeURIComponent(JSON.stringify({eventId:registration.eventId,registrationId:registration.id,registrationToken:registration.token}));}
function reviewReceipt_(result){return HtmlService.createHtmlOutput('<!doctype html><html lang="ko"><head><meta name="referrer" content="no-referrer"></head><body style="font:17px/1.8 system-ui;background:#f4f8fc;color:#17364e;padding:30px;max-width:650px;margin:auto"><main style="background:white;border:1px solid #d8e4ef;border-radius:20px;padding:30px"><p style="color:#126aa6">올타에듀 학부모 설명회 후기</p><h1>'+(result.ok?'마음을 나눠 주셔서 감사합니다.':'후기를 보내지 못했습니다.')+'</h1><p>'+escape_(result.ok?(result.duplicate?'이미 접수된 후기입니다. 중복으로 저장하지 않았습니다.':'깨달음의 기쁨을 함께 나눌 수 있도록 소중한 의견을 살펴보겠습니다.'):result.message)+'</p></main></body></html>').setTitle('올타에듀 · 설명회 후기').addMetaTag('viewport','width=device-width,initial-scale=1');}
